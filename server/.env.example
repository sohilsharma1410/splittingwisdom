# Supabase Postgres connection string (Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Supabase project (used for the private "receipts" Storage bucket)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=change-me

# Google AI Studio API key, used server-side only for receipt OCR (Phase 5)
GEMINI_API_KEY=change-me
# Model used for receipt OCR. Defaults to gemini-2.0-flash, which Google may retire — if extraction
# starts failing, check the server log for the reason and set a current Flash model here.
# GEMINI_MODEL=gemini-2.0-flash

# Origin of the deployed client, for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Port the Express server listens on (Render sets this automatically in production)
PORT=4000
