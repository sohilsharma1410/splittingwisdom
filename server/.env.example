# Supabase Postgres connection string (Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Supabase project (used for the private "receipts" Storage bucket)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=change-me

# Google AI Studio API key, used server-side only for receipt OCR (Phase 5)
GEMINI_API_KEY=change-me
# Model used for receipt OCR. Defaults to gemini-2.0-flash, which Google may retire — if extraction
# starts failing, check the server log for the reason and set a current Flash model here.
# GEMINI_MODEL=gemini-2.0-flash

# Reads receipts on the Pi instead of Gemini (plan D18). deploy/pi/docker-compose.yml sets these.
# OCR_DRIVER=local
# OCR_URL=http://ocr:8000

# Origin of the deployed client, for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Port the Express server listens on (Render sets this automatically in production)
PORT=4000

# --- Deployment switches. The defaults suit Render + Supabase; the Pi's values
# --- are set in deploy/pi/docker-compose.yml.

# TLS to DATABASE_URL (default on). Pi: off.
# DATABASE_SSL=on
# DATABASE_URL goes through a transaction pooler, so no prepared statements (default on). Pi: off.
# DATABASE_POOLER=on
# Also serve the built client from this server (default false). Pi: true.
# SERVE_CLIENT=false
# Where the built client is. Defaults to client/dist in this repo.
# CLIENT_DIST_DIR=
# Where receipt images live: supabase (default) or local. Pi: local.
# STORAGE_DRIVER=supabase
# Folder for receipt images, required when STORAGE_DRIVER=local.
# RECEIPTS_DIR=

# --- Standby / failover (plan workstream S). All optional: with APP_ROLE unset
# --- the server behaves as a single node (no fencing), exactly as before.

# primary (the Pi) | standby (Render). Mutating /api routes answer 503 while
# this node is not the active primary per system_state.
# APP_ROLE=standby
# Database holding system_state (the standby/Supabase DB). Defaults: primary ->
# SYNC_TARGET_DATABASE_URL, standby -> DATABASE_URL.
# ROLE_STATE_DATABASE_URL=
# ROLE_STATE_SSL=on
# ROLE_CACHE_SECONDS=10
# ROLE_STALE_GRACE_SECONDS=600
# HEARTBEAT_INTERVAL_SECONDS=15

# Failover controller (runs on the standby/Render only)
# CONTROLLER_ENABLED=true
# PI_PUBLIC_URL=https://pi.tailnet-name.ts.net
# CONTROLLER_PROBE_INTERVAL_SECONDS=30
# CONTROLLER_FAIL_THRESHOLD=3
# CONTROLLER_HEALTHY_THRESHOLD=5

# Forward sync agent (runs on the Pi): npm run sync:agent --workspace=server
# SYNC_TARGET_DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-xx.pooler.supabase.com:6543/postgres
# SYNC_TARGET_SSL=on
# SYNC_SOURCE_SSL=off
# SUPABASE_ANON_KEY=   # with SUPABASE_URL enables the 6-hourly REST keep-alive ping
