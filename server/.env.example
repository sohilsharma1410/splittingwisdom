# Supabase Postgres connection string (Settings > Database > Connection string > URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Long random string used to sign session cookies
SESSION_SECRET=change-me-to-a-long-random-string

# Supabase project (used for the receipt-image storage bucket, Phase 3+)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=change-me

# Origin of the deployed client, for CORS (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# Port the Express server listens on (Render sets this automatically in production)
PORT=4000
