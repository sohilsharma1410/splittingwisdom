# Copy to deploy/pi/.env (git-ignored) and keep it private: chmod 600 .env
# docker-compose.yml sets the rest: DATABASE_URL, DATABASE_SSL=off,
# DATABASE_POOLER=false, SERVE_CLIENT=true, STORAGE_DRIVER=local, RECEIPTS_DIR.

# Postgres password. Use hex so it's safe inside a URL: openssl rand -hex 32
POSTGRES_PASSWORD=

# Signs session cookies: openssl rand -hex 32
# At the real cutover (P4.5) replace it with Render's value, so both nodes accept
# the same sessions. Changing it logs everyone out.
SESSION_SECRET=

# Receipts are read on the Pi by the ocr container, with no key needed (plan D18).
# Gemini is only used by other features, such as voice, when they're built.
GEMINI_API_KEY=
# GEMINI_MODEL=

# Baked into the client at build time, so run `docker compose build` after changing.
# Leave unset until sync runs in M4 (plan D17). Both must be set, or failover stays off.
# VITE_PRIMARY_URL=https://firebatpi.<tailnet>.ts.net
# VITE_STANDBY_URL=https://splittingwisdom-client.vercel.app

# --- Standby and sync: leave these off until M4 ---------------------------------
# Setting them connects this node to the real Supabase database.
# APP_ROLE=primary
# SYNC_TARGET_DATABASE_URL=
# SYNC_TARGET_SSL=on
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
