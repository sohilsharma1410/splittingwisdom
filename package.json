{
  "name": "splittingwisdom",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "check": "npm run check --workspace=shared && npm run check --workspace=server && npm run check --workspace=client",
    "test": "npm run test --workspace=shared",
    "build": "npm run build --workspace=shared && npm run build --workspace=server && npm run build --workspace=client",
    "db:generate": "npm run db:generate --workspace=server",
    "db:migrate": "npm run db:migrate --workspace=server"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "bcrypt@6.0.0": true,
    "fsevents@2.3.3": true
  }
}
