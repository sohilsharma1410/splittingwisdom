# Leave UNSET in production: the client calls /api on its own origin, and
# Vercel/Express forward it (see client/vercel.json). Only set this for local
# dev against an API on another port.
# VITE_API_URL=http://localhost:4000

# Failover (PWA, S7). Both unset = feature off (local dev, plain Vercel).
# The SAME build is deployed to both copies of the app, so both URLs are set.
# VITE_PRIMARY_URL=https://<pi>.<tailnet>.ts.net
# VITE_STANDBY_URL=https://splittingwisdom-client.vercel.app
